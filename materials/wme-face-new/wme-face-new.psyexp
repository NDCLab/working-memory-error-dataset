        <Param val="" valType="extendedCode" updates="constant" name="Begin Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin JS Experiment"/>
        <Param val="util.shuffle(WM_LOCS);&amp;#10;util.shuffle(WM_NUMBERS);&amp;#10;wm_locs = WM_LOCS.slice(0, 5);&amp;#10;wm_x = function () {&amp;#10;    var _pj_a = [], _pj_b = wm_locs;&amp;#10;    for (var _pj_c = 0, _pj_d = _pj_b.length; (_pj_c &lt; _pj_d); _pj_c += 1) {&amp;#10;        var i = _pj_b[_pj_c];&amp;#10;        _pj_a.push(np.random.choice(i[0]));&amp;#10;    }&amp;#10;    return _pj_a;&amp;#10;}&amp;#10;.call(this);&amp;#10;wm_y = function () {&amp;#10;    var _pj_a = [], _pj_b = wm_locs;&amp;#10;    for (var _pj_c = 0, _pj_d = _pj_b.length; (_pj_c &lt; _pj_d); _pj_c += 1) {&amp;#10;        var i = _pj_b[_pj_c];&amp;#10;        _pj_a.push(np.random.choice(i[1]));&amp;#10;    }&amp;#10;    return _pj_a;&amp;#10;}&amp;#10;.call(this);&amp;#10;wm_number = [&quot;&quot;, &quot;&quot;, &quot;&quot;, &quot;&quot;, &quot;&quot;];&amp;#10;for (var i, _pj_c = 0, _pj_a = util.range(wm_load), _pj_b = _pj_a.length; (_pj_c &lt; _pj_b); _pj_c += 1) {&amp;#10;    i = _pj_a[_pj_c];&amp;#10;    wm_number[i] = WM_NUMBERS[i];&amp;#10;}&amp;#10;" valType="extendedCode" updates="constant" name="Begin JS Routine"/>
        <Param val="#np.random.choice(np.linspace(1, 1.20, 9)) for i in range(4)&amp;#10;shuffle(WM_LOCS)&amp;#10;shuffle(WM_NUMBERS)&amp;#10;wm_locs = WM_LOCS[:5]&amp;#10;wm_x = \&amp;#10;[np.random.choice(i[0]) for i in wm_locs]&amp;#10;&amp;#10;wm_y = \&amp;#10;[np.random.choice(i[1]) for i in wm_locs]&amp;#10;&amp;#10;wm_number = [&quot;&quot;, &quot;&quot;, &quot;&quot;, &quot;&quot;, &quot;&quot;]&amp;#10;for i in range(wm_load):&amp;#10;    wm_number[i] = WM_NUMBERS[i]" valType="extendedCode" updates="constant" name="Begin Routine"/>
