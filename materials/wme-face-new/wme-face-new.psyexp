    <Routine name="task_block_fb">
      <CodeComponent name="stimTask_code_4">
        <Param val="" valType="extendedCode" updates="constant" name="Before Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Before JS Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin JS Experiment"/>
        <Param val="blockAcc = (numCorr / trialNum);&amp;#10;if ((n_responses &lt; 37)) {&amp;#10;    blockFeed = &quot;Please, provide a response each time you asked to remember the faces.\n\n&quot;;&amp;#10;} else {&amp;#10;    blockFeed = &quot;&quot;;&amp;#10;}&amp;#10;if ((blockCounter &lt; 10)) {&amp;#10;    if ((blockAcc &gt;= FL_THRESH)) {&amp;#10;        if ((blockAcc &lt; (FL_THRESH + 0.1))) {&amp;#10;            blockFeed += &quot;Good job for the Arrow Alert.&quot;;&amp;#10;            blockFeedCat = 1;&amp;#10;        } else {&amp;#10;            if ((blockAcc &gt;= (FL_THRESH + 0.1))) {&amp;#10;                blockFeed += &quot;Respond faster in the Arrow Alert Game, but take as much time as you need to remember the faces.&quot;;&amp;#10;                blockFeedCat = 2;&amp;#10;            }&amp;#10;        }&amp;#10;    } else {&amp;#10;        if ((blockAcc &lt; FL_THRESH)) {&amp;#10;            blockFeed += &quot;Respond more accurately in the Arrow Alert Game and take as much time as you need to remember the first face.&quot;;&amp;#10;            blockFeedCat = 3;&amp;#10;        }&amp;#10;    }&amp;#10;} else {&amp;#10;    if ((blockCounter === 10)) {&amp;#10;        blockFeed = &quot;You have completed all blocks&quot;;&amp;#10;    }&amp;#10;}&amp;#10;ST_block_loop.addData(&quot;blockAcc&quot;, blockAcc);&amp;#10;ST_block_loop.addData(&quot;blockFeedCat&quot;, blockFeedCat);&amp;#10;numCorr = 0;&amp;#10;trialNum = 0;&amp;#10;" valType="extendedCode" updates="constant" name="Begin JS Routine"/>
        <Param val="# calculate block accuracy&amp;#10;blockAcc = numCorr / trialNum&amp;#10;&amp;#10;if n_responses &lt; 37:&amp;#10;    blockFeed = &quot;Please, provide a response each time you asked to remember the faces.\n\n&quot;&amp;#10;else:&amp;#10;    blockFeed = &quot;&quot;&amp;#10;&amp;#10;if blockCounter &lt; 10:&amp;#10;    if blockAcc &gt;= FL_THRESH:&amp;#10;        if blockAcc &lt; FL_THRESH + .1:&amp;#10;            blockFeed += 'Good job for the Arrow Alert.'&amp;#10;            blockFeedCat = 1&amp;#10;        elif blockAcc &gt;= FL_THRESH + .1:&amp;#10;            blockFeed += 'Respond faster in the Arrow Alert Game, but take as much time as you need to remember the faces.'&amp;#10;            blockFeedCat = 2&amp;#10;    elif blockAcc &lt; FL_THRESH:&amp;#10;        blockFeed += 'Respond more accurately in the Arrow Alert Game and take as much time as you need to remember the first face.'&amp;#10;        blockFeedCat = 3&amp;#10;elif blockCounter == 10:&amp;#10;    blockFeed = 'You have completed all blocks'&amp;#10;&amp;#10;# write block accuracy to data&amp;#10;ST_block_loop.addData('blockAcc', blockAcc)&amp;#10;# save this block's feedback to our output file&amp;#10;ST_block_loop.addData('blockFeedCat', blockFeedCat)&amp;#10;&amp;#10;# reset&amp;#10;numCorr = 0&amp;#10;trialNum = 0&amp;#10;" valType="extendedCode" updates="constant" name="Begin Routine"/>
        <Param val="Auto-&gt;JS" valType="str" updates="None" name="Code Type"/>
        <Param val="" valType="extendedCode" updates="constant" name="Each Frame"/>
        <Param val="" valType="extendedCode" updates="constant" name="Each JS Frame"/>
        <Param val="" valType="extendedCode" updates="constant" name="End Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="End JS Experiment"/>
        <Param val="n_responses = 0;&amp;#10;" valType="extendedCode" updates="constant" name="End JS Routine"/>
        <Param val="n_responses = 0" valType="extendedCode" updates="constant" name="End Routine"/>
        <Param val="False" valType="bool" updates="None" name="disabled"/>
        <Param val="stimTask_code_4" valType="code" updates="None" name="name"/>
      </CodeComponent>
      <TextComponent name="block_fb_text">
        <Param val="white" valType="color" updates="constant" name="color"/>
        <Param val="rgb" valType="str" updates="constant" name="colorSpace"/>
        <Param val="1" valType="num" updates="constant" name="contrast"/>
        <Param val="False" valType="bool" updates="None" name="disabled"/>
