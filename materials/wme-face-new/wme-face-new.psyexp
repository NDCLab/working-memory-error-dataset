    <Routine name="new_flanker">
      <CodeComponent name="new_flanker_code">
        <Param val="" valType="extendedCode" updates="constant" name="Before Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Before JS Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin JS Experiment"/>
        <Param val="target_number = np.random.choice(WM_NUMBERS);&amp;#10;util.shuffle(FL_LOCS);&amp;#10;flanker_locs = FL_LOCS.slice(0, 4);&amp;#10;flanker_x = function () {&amp;#10;    var _pj_a = [], _pj_b = flanker_locs;&amp;#10;    for (var _pj_c = 0, _pj_d = _pj_b.length; (_pj_c &lt; _pj_d); _pj_c += 1) {&amp;#10;        var i = _pj_b[_pj_c];&amp;#10;        _pj_a.push(np.random.choice(i[0]));&amp;#10;    }&amp;#10;    return _pj_a;&amp;#10;}&amp;#10;.call(this);&amp;#10;flanker_y = function () {&amp;#10;    var _pj_a = [], _pj_b = flanker_locs;&amp;#10;    for (var _pj_c = 0, _pj_d = _pj_b.length; (_pj_c &lt; _pj_d); _pj_c += 1) {&amp;#10;        var i = _pj_b[_pj_c];&amp;#10;        _pj_a.push(np.random.choice(i[1]));&amp;#10;    }&amp;#10;    return _pj_a;&amp;#10;}&amp;#10;.call(this);&amp;#10;ISIRange = np.linspace(700, 705, 5);&amp;#10;util.shuffle(ISIRange);&amp;#10;thisISI = (ISIRange[0] / 1000);&amp;#10;flanker_number = [&quot;&quot;, &quot;&quot;, &quot;&quot;, &quot;&quot;];&amp;#10;num_to_plug = np.random.choice(function () {&amp;#10;    var _pj_a = [], _pj_b = WM_NUMBERS;&amp;#10;    for (var _pj_c = 0, _pj_d = _pj_b.length; (_pj_c &lt; _pj_d); _pj_c += 1) {&amp;#10;        var num = _pj_b[_pj_c];&amp;#10;        if ((num !== target_number)) {&amp;#10;            _pj_a.push(num);&amp;#10;        }&amp;#10;    }&amp;#10;    return _pj_a;&amp;#10;}&amp;#10;.call(this));&amp;#10;for (var i, _pj_c = 0, _pj_a = util.range(n_distractors), _pj_b = _pj_a.length; (_pj_c &lt; _pj_b); _pj_c += 1) {&amp;#10;    i = _pj_a[_pj_c];&amp;#10;    flanker_number[i] = num_to_plug;&amp;#10;}&amp;#10;" valType="extendedCode" updates="constant" name="Begin JS Routine"/>
        <Param val="#np.random.choice(np.linspace(1, 1.20, 9)) for i in range(4)&amp;#10;target_number = np.random.choice(WM_NUMBERS)&amp;#10;shuffle(FL_LOCS)&amp;#10;flanker_locs = FL_LOCS[:4]&amp;#10;flanker_x = \&amp;#10;[np.random.choice(i[0]) for i in flanker_locs]&amp;#10;#[&amp;#10;#np.random.choice(np.linspace(1, 1.20, 9)),&amp;#10;#np.random.choice(np.linspace(1, 1.20, 9)),&amp;#10;#np.random.choice(np.linspace(-1, -1.20, 9)),&amp;#10;#np.random.choice(np.linspace(-1, -1.20, 9)),&amp;#10;#]&amp;#10;&amp;#10;flanker_y = \&amp;#10;[np.random.choice(i[1]) for i in flanker_locs]&amp;#10;#[&amp;#10;#np.random.choice(np.linspace(1, 1.20, 9)),&amp;#10;#np.random.choice(np.linspace(-1, -1.20, 9)),&amp;#10;#np.random.choice(np.linspace(1, 1.20, 9)),&amp;#10;#np.random.choice(np.linspace(-1, -1.20, 9)),&amp;#10;#]&amp;#10;&amp;#10;ISIRange = np.linspace(700, 705, 5)&amp;#10;shuffle(ISIRange)&amp;#10;thisISI = ISIRange[0]/1000&amp;#10;&amp;#10;flanker_number = [&quot;&quot;, &quot;&quot;, &quot;&quot;, &quot;&quot;]&amp;#10;num_to_plug = np.random.choice([num for num in WM_NUMBERS if num != target_number])&amp;#10;for i in range(n_distractors):&amp;#10;    flanker_number[i] = num_to_plug" valType="extendedCode" updates="constant" name="Begin Routine"/>
        <Param val="Auto-&gt;JS" valType="str" updates="None" name="Code Type"/>
        <Param val="" valType="extendedCode" updates="constant" name="Each Frame"/>
        <Param val="" valType="extendedCode" updates="constant" name="Each JS Frame"/>
        <Param val="" valType="extendedCode" updates="constant" name="End Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="End JS Experiment"/>
        <Param val="trialNum = (trialNum + 1);&amp;#10;trialNum_fl += 1;&amp;#10;if (new_key_resp.keys) {&amp;#10;    if ((new_key_resp.keys[0] === &quot;z&quot;)) {&amp;#10;        if ((target_number &lt; 5)) {&amp;#10;            accuracy = 1;&amp;#10;            numCorr = (numCorr + 1);&amp;#10;            numCorr_fl += 1;&amp;#10;        } else {&amp;#10;            if ((target_number &gt; 5)) {&amp;#10;                accuracy = 0;&amp;#10;            }&amp;#10;        }&amp;#10;    } else {&amp;#10;        if ((new_key_resp.keys[0] === &quot;m&quot;)) {&amp;#10;            if ((target_number &gt; 5)) {&amp;#10;                accuracy = 1;&amp;#10;                numCorr = (numCorr + 1);&amp;#10;                numCorr_fl += 1;&amp;#10;            } else {&amp;#10;                if ((target_number &lt; 5)) {&amp;#10;                    accuracy = 0;&amp;#10;                }&amp;#10;            }&amp;#10;        }&amp;#10;    }&amp;#10;} else {&amp;#10;    if ((! new_key_resp.keys)) {&amp;#10;        accuracy = 0;&amp;#10;    }&amp;#10;}&amp;#10;trial_loop_new.addData(&quot;fl_accuracy&quot;, accuracy);&amp;#10;" valType="extendedCode" updates="constant" name="End JS Routine"/>
        <Param val="#iterate trial number for this supertrial&amp;#10;trialNum = trialNum + 1&amp;#10;#iterate trial number for this block&amp;#10;trialNum_fl += 1&amp;#10;&amp;#10;if new_key_resp.keys: #if at least one response was made this trial&amp;#10;    if new_key_resp.keys[0] == 'z': #if the FIRST button pressed was a '1'&amp;#10;        if target_number &lt; 5: #if a left target stim was shown this trial&amp;#10;            accuracy = 1 #mark this trial as correct&amp;#10;            numCorr = numCorr +1&amp;#10;            numCorr_fl += 1#iterate number of correct responses for this supertrial&amp;#10;        elif target_number &gt; 5: #if a right target stim was shown this trial&amp;#10;            accuracy = 0 #mark this trial as an error&amp;#10;    elif new_key_resp.keys[0] == 'm': #if the FIRST button pressed was a '8'&amp;#10;        if target_number &gt; 5: #if a right target stim was shown this trial&amp;#10;            accuracy = 1 #mark this trial as correct&amp;#10;            numCorr = numCorr +1&amp;#10;            numCorr_fl += 1#iterate number of correct responses for this supertrial&amp;#10;        elif target_number &lt; 5: #if a left target stim was shown this trial&amp;#10;            accuracy = 0 #mark this trial as an error&amp;#10;&amp;#10;elif not new_key_resp.keys: # if no response was made&amp;#10;    accuracy = 0&amp;#10;&amp;#10;# save this trial's accuracy to our output file&amp;#10;trial_loop_new.addData('fl_accuracy', accuracy) " valType="extendedCode" updates="constant" name="End Routine"/>
        <Param val="False" valType="bool" updates="None" name="disabled"/>
        <Param val="new_flanker_code" valType="code" updates="None" name="name"/>
