        <Param val="/* Syntax Error: Fix Python code */" valType="extendedCode" updates="constant" name="End JS Routine"/>
        <Param val="wm_response = wm_recall_typedResp_2.text&amp;#10;correct_numbers = used_numbers.copy()&amp;#10;wm_accuracy = 0&amp;#10;for i in wm_response:&amp;#10;    if i in correct_numbers:&amp;#10;        wm_accuracy += 1/len(wm_response)&amp;#10;        correct_numbers.remove(i)&amp;#10;&amp;#10;if wm_response == ''.join(used_numbers):&amp;#10;    wm_fb_text = &quot;You are right! \nThe numbers were {}&quot;.format(''.join(used_letters))&amp;#10;elif wm_accuracy &gt;= WM_THRESH:&amp;#10;    wm_fb_text = &quot;You have almost made it! \nThe numbers were {} \n\nPlease try to recall the numbers in the order they appeared&quot;.format(''.join(used_numbers))&amp;#10;elif wm_accuracy &lt; WM_THRESH:&amp;#10;    wm_fb_text = &quot;Not quite right... \nThe numbers were {} \n\nPlease try to recall the numbers in the order they appeared&quot;.format(''.join(used_numbers))&amp;#10;&amp;#10;# calculate accuracy and add trial to counter&amp;#10;numCorr += wm_accuracy&amp;#10;trialNum += 1&amp;#10;&amp;#10;pracWM_trial_loop.addData('pracWM_wm_response', wm_response)&amp;#10;# save this trial's wm accuracy to our output file&amp;#10;pracWM_trial_loop.addData('pracWM_wm_accuracy', wm_accuracy)&amp;#10;&amp;#10;# empty lists of used letters&amp;#10;used_numbers = []&amp;#10;shown_numbers = []" valType="extendedCode" updates="constant" name="End Routine"/>
