        <Param val="supertrial_numbers = WM_NUMBERS.copy();&amp;#10;util.shuffle(supertrial_numbers);&amp;#10;used_numbers = [];&amp;#10;used_numbers_fl = [];&amp;#10;shown_numbers = [];&amp;#10;" valType="extendedCode" updates="constant" name="Begin JS Routine"/>
